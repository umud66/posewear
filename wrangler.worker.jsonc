{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "posewear",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "previews": {
    "ai": {
      "binding": "AI"
    }
  }
}
